FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY pom.xml ./
COPY blog-common/pom.xml blog-common/pom.xml
COPY blog-pojo/pom.xml blog-pojo/pom.xml
COPY blog-server/pom.xml blog-server/pom.xml
COPY blog-plugin-demo/pom.xml blog-plugin-demo/pom.xml

RUN mvn -B -ntp -DskipTests dependency:go-offline

COPY blog-common/src blog-common/src
COPY blog-pojo/src blog-pojo/src
COPY blog-server/src blog-server/src
COPY blog-plugin-demo/src blog-plugin-demo/src

RUN mvn -B -ntp -DskipTests clean package && cp blog-server/target/blog-server-0.0.1-SNAPSHOT.jar /workspace/app.jar

FROM eclipse-temurin:21-jre-jammy
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app
COPY --from=build /workspace/app.jar /app/app.jar
COPY --from=build /workspace/blog-plugin-demo/target/blog-plugin-demo-0.0.1-SNAPSHOT.jar /opt/review-defaults/blog-plugin-demo.jar
COPY --from=build /workspace/blog-plugin-demo/target/blog-plugin-demo-0.0.1-SNAPSHOT-double.jar /opt/review-defaults/blog-plugin-demo-double.jar
COPY docker/review-entrypoint.sh /app/docker-entrypoint.sh
# Windows 检出常为 CRLF，会导致容器内 exec 报 no such file or directory（实际为 shebang 含 \r）
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/app/docker-entrypoint.sh"]
