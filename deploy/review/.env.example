# 复制为 .env 后使用：copy .env.example .env  （Linux/macOS: cp .env.example .env）

# ---------- MySQL ----------
# MYSQL_ROOT_PASSWORD：官方镜像设置 root 密码；评审 compose 默认让 Spring 用 root 连接，密码与此相同。
MYSQL_ROOT_PASSWORD=root

# （可选）覆盖数据库登录用户/密码；不设则 root + 与 MYSQL_ROOT_PASSWORD 一致。
# HM_DB_USER=root
# HM_DB_PASSWORD=root

# Level2：启动后是否对 plugins/page-size 做一次补扫描（解决 jar 在 Watch 注册前已存在）。Docker 默认 true；本地纯手动演示可设 false。
# EXTERNAL_PLUGIN_BOOT_SCAN=true

# JWT（至少 32 字符建议自行更换）
HM_JWT_SECRET_KEY=review-jwt-secret-change-me-at-least-32-bytes!!

# 可选能力：默认 false；设为 true 时需配置对应密钥（见下方）
HM_FEATURE_DEEPSEEK=false
HM_FEATURE_VOLCENGINE_COVER=false

# 开启 DeepSeek 文章简介时填写
# DEEPSEEK_API_KEY=

# 开启火山即梦封面时填写（且通常需要七牛用于转存）
# VOLCENGINE_ACCESS_KEY=
# VOLCENGINE_SECRET_KEY=

# 七牛：四项齐全则管理端上传 token 等可用；留空即不启用
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=

# 端口：8888 = 浏览器访问博客前台（Vue + 反代 /api）；8080 = 直连后端 API
REVIEW_NGINX_PORT=8888
REVIEW_BACKEND_PORT=8080
REVIEW_MYSQL_PORT=33060
