# 复制为 .env 后使用：copy .env.example .env  （Linux/macOS: cp .env.example .env）

# MySQL（compose 内建库）
MYSQL_ROOT_PASSWORD=root
HM_DB_USER=ayeezblog
HM_DB_PASSWORD=ayeezblog_review

# JWT（至少 32 字符建议自行更换）
HM_JWT_SECRET_KEY=review-jwt-secret-change-me-at-least-32-bytes!!

# 可选能力：默认 false；设为 true 时需配置对应密钥（见下方）
HM_FEATURE_DEEPSEEK=false
HM_FEATURE_VOLCENGINE_COVER=false

# 开启 DeepSeek 文章简介时填写
# DEEPSEEK_API_KEY=

# 开启火山即梦封面时填写（且通常需要七牛用于转存）
# VOLCENGINE_ACCESS_KEY=
# VOLCENGINE_SECRET_KEY=

# 七牛：四项齐全则管理端上传 token 等可用；留空即不启用
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=

# 端口（避免与本机 80 / 3306 冲突）
REVIEW_NGINX_PORT=8888
REVIEW_BACKEND_PORT=8080
REVIEW_MYSQL_PORT=33060
