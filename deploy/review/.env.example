# 复制为 .env 后使用：copy .env.example .env  （Linux/macOS: cp .env.example .env）

# ---------- MySQL ----------
# MYSQL_ROOT_PASSWORD：官方镜像设置 root 密码；评审 compose 默认让 Spring 用 root 连接，密码与此相同。
MYSQL_ROOT_PASSWORD=root

# （可选）覆盖数据库登录用户/密码；不设则 root + 与 MYSQL_ROOT_PASSWORD 一致。
# HM_DB_USER=root
# HM_DB_PASSWORD=root

# ---------- Level1 / Level2（评审 Docker）----------
# 默认：外部插件目录监听 + 启动补扫已开启（EXTERNAL_PLUGIN_BOOT_SCAN=true），无需为 Level2 再改 .env。
# demo jar 首次启动会出现在 plugins/bundled-demo（与监听的 page-size 分离）。
# Level2 演示：在 deploy/review 下将 jar 复制到监听目录，例如：
#   cp plugins/bundled-demo/*.jar plugins/page-size/
# （Windows PowerShell: Copy-Item plugins/bundled-demo/*.jar plugins/page-size/）
# 若曾误把 jar 放进 page-size 导致 Level1 被外部插件接管，删除 page-size 内 *.jar 后 restart backend，并 POST /post/runtime/revert-page-size-rule-to-configured。
# 若需关闭启动补扫（仅保留目录 Watch）：取消下行注释并设为 false
# EXTERNAL_PLUGIN_BOOT_SCAN=false

# JWT（至少 32 字符建议自行更换）
HM_JWT_SECRET_KEY=review-jwt-secret-change-me-at-least-32-bytes!!

# 可选能力：默认 false；设为 true 时需配置对应密钥（见下方）
HM_FEATURE_DEEPSEEK=false
HM_FEATURE_VOLCENGINE_COVER=false

# 开启 DeepSeek 文章简介时填写
# DEEPSEEK_API_KEY=

# 开启火山即梦封面时填写（且通常需要七牛用于转存）
# VOLCENGINE_ACCESS_KEY=
# VOLCENGINE_SECRET_KEY=

# 七牛：四项齐全则管理端上传 token 等可用；留空即不启用
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=

# 端口：8888 = 浏览器访问博客前台（Vue + 反代 /api）；8080 = 直连后端 API
REVIEW_NGINX_PORT=8888
REVIEW_BACKEND_PORT=8080
REVIEW_MYSQL_PORT=33060
