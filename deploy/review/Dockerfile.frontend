# 构建上下文：仓库根目录（含 AyeezBlog-Frontend），见 docker-compose.yml context
FROM node:20-alpine AS build
WORKDIR /app

COPY AyeezBlog-Frontend/package.json AyeezBlog-Frontend/package-lock.json ./
RUN npm ci

COPY AyeezBlog-Frontend/ ./

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/review/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
