<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ayeez.blogserver.mapper.AuthMapper">


    <select id="findByUsername" resultType="cn.ayeez.blogpojo.po.Auth">
        SELECT *
        FROM user
        WHERE username = #{username}
          AND role = 1
          AND status = 1
    </select>

    <update id="updatePassword">
        UPDATE user
        SET password = #{password}
        WHERE id = #{id}
    </update>
</mapper>
