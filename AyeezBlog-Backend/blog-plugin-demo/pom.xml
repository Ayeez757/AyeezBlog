<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ayeez</groupId>
        <artifactId>AyeezBlog-Backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>blog-plugin-demo</artifactId>
    <name>blog-plugin-demo</name>
    <description>Day6 external plugin demo module</description>

    <properties>
        <plugin.host.classes>${project.basedir}/../blog-server/target/classes</plugin.host.classes>
        <plugin.host.jar>${project.basedir}/../blog-server/target/blog-server-0.0.1-SNAPSHOT-plain.jar</plugin.host.jar>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-classpath</arg>
                        <arg>${plugin.host.classes}${path.separator}${plugin.host.jar}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
