        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Admin /admin/login" enabled="true">
            <stringProp name="HTTPSampler.path">${__P(base_path,)}/admin/login</stringProp>
