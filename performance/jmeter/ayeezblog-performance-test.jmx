          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput

def now = System.currentTimeMillis()
def suffix = "${ctx.getThreadNum()}-${now}"
def title = "perf-crud-${suffix}"
def baseDate = "2026-04-15"
def addBody = [
  title: title,
  tags: ["压测", "JMeter"],
  category: "性能测试,本地环境",
  description: "JMeter CRUD性能测试-新增",
  cover: "https://blog.ayeez.cn/imgs/bg/p4.jpg",
  abbrlink: "perf${suffix}".take(16),
  date: baseDate,
  updated: baseDate,
  content: "## perf ${suffix}\\n新增内容"
]
def updateBody = [
  title: "${title}-updated",
  tags: ["压测", "JMeter", "更新"],
  category: "性能测试,本地环境",
  description: "JMeter CRUD性能测试-更新",
  cover: "https://blog.ayeez.cn/imgs/bg/p5.jpg",
  abbrlink: "up${suffix}".take(16),
  date: baseDate,
  updated: baseDate,
  content: "## perf ${suffix}\\n更新内容"
]
vars.put("crud_title", title)
vars.put("crud_add_body", JsonOutput.toJson(addBody))
vars.put("crud_update_body_template", JsonOutput.toJson(updateBody))
vars.put("crud_post_id", "")</stringProp>
