                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;username&quot;:&quot;${__P(admin_username,admin)}&quot;,&quot;password&quot;:&quot;${__P(admin_password,admin)}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract CRUD admin token" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
def token = ''
try {
  def obj = new JsonSlurper().parseText(body)
  token = (
    obj?.data?.token ?:
    obj?.data?.jwt ?:
    obj?.data?.accessToken ?:
    obj?.token ?:
    obj?.jwt ?:
    obj?.accessToken ?:
    obj?.data?.data?.token ?:
    ''
  ).toString()
} catch (Exception ignored) {
}
if (!token) {
  def m = (body =~ /"(?:token|jwt|accessToken)"\s*:\s*"([^"]+)"/)
  if (m.find()) {
    token = m.group(1)
  }
}
if (!token) {
  def auth = prev.getResponseHeaders()?.readLines()?.find { it.toLowerCase().startsWith('authorization:') }
  if (auth) {
    token = auth.split(':', 2)[1].trim().replaceFirst('(?i)^Bearer\\s+', '')
  }
}
token = token?.trim()
vars.put('crud_admin_token', token)</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert CRUD token extracted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def token = vars.get('crud_admin_token')
if (token == null || token.trim().isEmpty()) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Login succeeded but no token extracted from response body')
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="CRUD Admin Authorization Header" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="token" elementType="Header">
              <stringProp name="Header.name">token</stringProp>
              <stringProp name="Header.value">${crud_admin_token}</stringProp>
            </elementProp>
            <elementProp name="Authorization" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${crud_admin_token}</stringProp>
            </elementProp>
          </collectionProp>
