        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build CRUD payload vars" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
