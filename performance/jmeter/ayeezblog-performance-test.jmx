        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract post_id with fallback" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
def postId = &apos;1&apos;
try {
  def obj = new JsonSlurper().parseText(body)
  def data = obj?.data
  def rows = data?.rows ?: data?.list ?: data?.records
  if (rows instanceof List &amp;&amp; !rows.isEmpty() &amp;&amp; rows[0]?.id != null) {
    postId = rows[0].id.toString()
  }
} catch (Exception ignored) {
}
vars.put(&apos;post_id&apos;, postId)</stringProp>
          </JSR223PostProcessor>
