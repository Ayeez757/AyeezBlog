        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract CRUD post id from list" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
def targetTitle = vars.get("crud_title")
def selectedId = ""
try {
  def obj = new JsonSlurper().parseText(body)
  def rows = obj?.data?.rows ?: obj?.data?.list ?: obj?.data?.records ?: []
  if (rows instanceof List) {
    def matched = rows.find { it?.title?.toString() == targetTitle }
    if (matched?.id != null) {
      selectedId = matched.id.toString()
    } else if (!rows.isEmpty() &amp;&amp; rows[0]?.id != null) {
      selectedId = rows[0].id.toString()
    }
  }
} catch (Exception ignored) {
}
vars.put("crud_post_id", selectedId)</stringProp>
