          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def template = vars.get("crud_update_body_template")
def postId = vars.get("crud_post_id")
def payload = [:]
if (template) {
  try {
    payload = (Map) new JsonSlurper().parseText(template)
  } catch (Exception ignored) {
    payload = [:]
  }
}
payload.id = postId
vars.put("crud_update_body", JsonOutput.toJson(payload))</stringProp>
